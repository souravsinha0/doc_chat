import uuid
from datetime import date, datetime
import requests
import streamlit as st

# --- CONFIGURATION ---
FASTAPI_URL = "http://localhost:8000"
PRIMARY_COLOR = "#00d1ff"  # Electric Blue
BG_GRADIENT = "linear-gradient(180deg, #0f172a 0%, #1e293b 100%)"

st.set_page_config(page_title="Velocis AI", layout="wide", page_icon="🤖")

# --- MODERN STYLING ---
st.markdown(f"""
<style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap');
    
    html, body, [class*="css"] {{
        font-family: 'Inter', sans-serif;
    }}

    /* Main App Background */
    .stApp {{
        background: {BG_GRADIENT};
        color: #f1f5f9;
    }}

    /* Hide Streamlit elements */
    [data-testid="stToolbar"] {{ display: none; }}
    header[data-testid="stHeader"] {{ background: rgba(0,0,0,0); }}

    /* Custom Card Styling */
    .custom-card {{
        background: rgba(30, 41, 59, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 1rem;
        margin-bottom: 10px;
        transition: transform 0.2s ease;
    }}
    
    .custom-card:hover {{
        border-color: {PRIMARY_COLOR};
        transform: translateY(-2px);
    }}

    /* Sidebar/Panel styling */
    [data-testid="stVerticalBlock"] > div:has(div.st-key-docs_panel) {{
        background: rgba(15, 23, 42, 0.5);
        border-radius: 15px;
        padding: 10px;
    }}

    /* File tag styling */
    .file-tag {{
        background: #334155;
        color: {PRIMARY_COLOR};
        font-size: 0.65rem;
        padding: 2px 6px;
        border-radius: 4px;
        font-weight: 600;
        text-transform: uppercase;
    }}

    /* Chat input styling */
    .stChatInputContainer {{
        padding-bottom: 20px;
    }}
</style>
""", unsafe_allow_html=True)

# ────────────────────────────────────────────────
# Session State & API Helpers
# ────────────────────────────────────────────────
if "initialized" not in st.session_state:
    st.session_state.update({
        "initialized": True,
        "authenticated": False,
        "token": None,
        "username": None,
        "current_session_id": str(uuid.uuid4()),
        "chat_messages": [],
        "uploaded_docs": [],
        "selected_doc_ids": [],
        "chat_sessions": [],
        "start_date": None,
        "end_date": None
    })

def api_call(method, endpoint, token=None, **kwargs):
    headers = {"Authorization": f"Bearer {token}"} if token else {}
    url = f"{FASTAPI_URL}{endpoint}"
    try:
        response = requests.request(method, url, headers=headers, **kwargs)
        if response.status_code == 401:
            st.session_state.authenticated = False
            st.rerun()
        return response.json() if response.status_code < 400 else {"error": response.text}
    except Exception as e:
        return {"error": str(e)}

# ────────────────────────────────────────────────
# Auth UI (Login/Register)
# ────────────────────────────────────────────────
if not st.session_state.authenticated:
    _, center, _ = st.columns([1, 1.5, 1])
    with center:
        st.markdown("<h1 style='text-align: center;'>🤖 Velocis AI</h1>", unsafe_allow_html=True)
        tab1, tab2 = st.tabs(["🔒 Login", "📝 Register"])
        
        with tab1:
            with st.form("login"):
                u = st.text_input("Username")
                p = st.text_input("Password", type="password")
                if st.form_submit_button("Sign In", use_container_width=True):
                    res = api_call("POST", "/login", json={"username": u, "password": p})
                    if "access_token" in res:
                        st.session_state.update({"authenticated": True, "token": res["access_token"], "username": res["username"]})
                        st.rerun()
                    else: st.error("Invalid credentials")
        with tab2:
            with st.form("reg"):
                nu = st.text_input("New Username")
                ne = st.text_input("Email")
                np = st.text_input("Password", type="password")
                if st.form_submit_button("Create Account", use_container_width=True):
                    res = api_call("POST", "/register", json={"username": nu, "email": ne, "password": np})
                    if "access_token" in res:
                        st.session_state.update({"authenticated": True, "token": res["access_token"], "username": res["username"]})
                        st.rerun()
    st.stop()

# ────────────────────────────────────────────────
# Main Interface
# ────────────────────────────────────────────────
# Header
h_col1, h_col2 = st.columns([8, 1])
h_col1.markdown(f"### Welcome back, **{st.session_state.username}** 👋")
if h_col2.button("Logout", type="secondary"):
    st.session_state.authenticated = True
    st.rerun()

left, center, right = st.columns([1, 2.5, 1], gap="medium")

# --- LEFT: Document Management ---
with left:
    st.markdown("#### 📁 Knowledge Base")
    with st.expander("⬆️ Upload Documents", expanded=False):
        files = st.file_uploader("Drop files", accept_multiple_files=True, label_visibility="collapsed")
        if files and st.button("Process Files", use_container_width=True):
            files_data = [("files", (f.name, f.getvalue(), f.type)) for f in files]
            api_call("POST", "/upload-documents/", st.session_state.token, files=files_data)
            st.session_state.uploaded_docs = [] # Reset to trigger refresh
            st.rerun()

    if not st.session_state.uploaded_docs:
        docs = api_call("GET", "/documents/", st.session_state.token)
        if isinstance(docs, list): st.session_state.uploaded_docs = docs

    st.markdown("---")
    # Document Card List
    for doc in st.session_state.uploaded_docs:
        with st.container():
            st.markdown(f"""
            <div class="custom-card">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span style="font-size: 0.9rem; font-weight: 600;">{doc['filename'][:20]}...</span>
                    <span class="file-tag">{doc['filename'].split('.')[-1]}</span>
                </div>
            </div>
            """, unsafe_allow_html=True)
            c1, c2 = st.columns([4, 1])
            is_sel = str(doc['id']) in st.session_state.selected_doc_ids
            if c1.checkbox("Select", value=is_sel, key=f"check_{doc['id']}"):
                if str(doc['id']) not in st.session_state.selected_doc_ids: 
                    st.session_state.selected_doc_ids.append(str(doc['id']))
            elif str(doc['id']) in st.session_state.selected_doc_ids:
                st.session_state.selected_doc_ids.remove(str(doc['id']))
            
            if c2.button("🗑️", key=f"del_{doc['id']}"):
                api_call("DELETE", f"/documents/{doc['id']}", st.session_state.token)
                st.session_state.uploaded_docs = []
                st.rerun()

# --- CENTER: Chat Experience ---
with center:
    c_head1, c_head2 = st.columns([4, 1])
    c_head1.markdown("#### 💬 AI Workspace")
    if c_head2.button("✨ New Chat", use_container_width=True):
        st.session_state.current_session_id = str(uuid.uuid4())
        st.session_state.chat_messages = []
        st.rerun()

    # Chat Container
    chat_placeholder = st.container(height=350, border=False)
    with chat_placeholder:
        for msg in st.session_state.chat_messages:
            with st.chat_message(msg["role"]):
                st.markdown(msg["content"])

    if prompt := st.chat_input("How can I help you today?"):
        st.session_state.chat_messages.append({"role": "user", "content": prompt})
        with chat_placeholder:
            with st.chat_message("user"): st.markdown(prompt)
            with st.chat_message("assistant"):
                with st.spinner("Analyzing documents..."):
                    payload = {
                        "query": prompt,
                        "session_id": st.session_state.current_session_id,
                        "document_ids": st.session_state.selected_doc_ids or None
                    }
                    res = api_call("POST", "/chat/", st.session_state.token, json=payload)
                    answer = res.get("answer", "I encountered an error.")
                    st.markdown(answer)
                    st.session_state.chat_messages.append({"role": "assistant", "content": answer})

# --- RIGHT: Chat History ---
with right:
    st.markdown("#### 📜 Recent Chats")
    
    if st.button("🔄 Refresh", use_container_width=True):
        st.session_state.chat_sessions = []
        st.rerun()

    sessions = api_call("GET", "/chat-sessions/", st.session_state.token)
    if isinstance(sessions, list):
        for sess in sessions:
            with st.container():
                st.markdown(f"""
                <div class="custom-card">
                    <small style="color: #94a3b8;">Session ID: {sess['session_id'][:8]}...</small>
                </div>
                """, unsafe_allow_html=True)
                sc1, sc2 = st.columns([4, 1])
                if sc1.button("View Chat", key=f"view_{sess['session_id']}", use_container_width=True):
                    st.session_state.current_session_id = sess["session_id"]
                    history = api_call("GET", f"/chat-history/{sess['session_id']}", st.session_state.token)
                    st.session_state.chat_messages = [{"role": m["role"], "content": m["content"]} for m in history]
                    st.rerun()
                if sc2.button("🗑️", key=f"del_sess_{sess['session_id']}"):
                    api_call("DELETE", f"/chat-sessions/{sess['session_id']}", st.session_state.token)
                    st.rerun()

st.divider()
st.caption("© 2026 Velocis Intelligence Unit • Secure Document Analysis")