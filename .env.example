# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=chatbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_password_here

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: ONPREM | OPENAI | GEMINI | OLLAMA
LLM_PROVIDER=ONPREM

# Used for OPENAI / GEMINI providers
LLM_MODEL=gpt-4o

# ── On-Premise vLLM (LLM_PROVIDER=ONPREM) ────────────────────────────────────
# URL of your vLLM server's OpenAI-compatible endpoint
ON_PREM_MODEL_URL=http://your-vllm-server:8001/v1
ON_PREM_MODEL_NAME=gpt-oss-20b

# ── Cloud API Keys (only needed for OPENAI / GEMINI) ─────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Ollama (LLM_PROVIDER=OLLAMA) ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=replace-with-a-long-random-secret

# ── React Frontend ────────────────────────────────────────────────────────────
# Public URL of the backend API (seen from the browser)
REACT_APP_API_URL=http://localhost:8000
